---
import TunnelPage from "../../components/TunnelPage.astro";
import {
  getTranslation,
  localizedLocaleDefinitions,
  type Locale,
} from "../../i18n";

export function getStaticPaths() {
  return localizedLocaleDefinitions.map(({ code, route }) => ({
    params: { locale: route },
    props: { locale: code },
  }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<TunnelPage locale={locale} copy={getTranslation(locale)} />
