---
import { ArrowLeft, ExternalLink, Plus, RefreshCw, Copy, Square, Trash, LogOut, X, RotateCcw, Settings } from '@lucide/astro';
import { localeDefinitions, getLocaleDefinition, getLocalePath, getTranslation, type Locale } from '../../i18n/index.ts';
import { consoleURL } from '../../console/model';
import HeaderFrame from '../../components/HeaderFrame.astro';
import LanguageSelect from '../../components/LanguageSelect.astro';
import '../../styles/design-system.css';
import '../../styles/console.css';

export function getStaticPaths() {
  return localeDefinitions.map(({ code }) => ({ params: { shell: `_shells/${code.toLowerCase()}` }, props: { locale: code } }));
}
interface Props { locale: Locale }
const { locale } = Astro.props;
const { console: copy, errors, brandHome } = getTranslation(locale);
const definition = getLocaleDefinition(locale);
---
<!doctype html>
<html lang={locale} dir={definition.direction}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="same-origin" />
    <meta name="theme-color" content="#071018" />
    <link rel="icon" type="image/png" href="/nodelane-mark-192.png" />
    <title>{copy.title} | NodeLane Tunnel</title>
  </head>
  <body class="console-body">
    <a class="skip-link" href="#console-main">{copy.details}</a>
    <HeaderFrame homeHref={getLocalePath(locale)} homeLabel={brandHome}>
        <nav slot="nav" class="main-nav" aria-label={copy.title}><a class="active" aria-current="page" href={consoleURL(locale)}>{copy.title}</a></nav>
        <Fragment slot="actions">
          <span id="account-name" class="muted"></span>
          <a id="identity-settings" class="icon-button" title={copy.identitySettings} aria-label={copy.identitySettings} rel="noreferrer" hidden><Settings size={18} /></a>
          <LanguageSelect locale={locale} label={copy.language} id="console-language" />
          <button type="button" id="logout" class="icon-button" title={copy.logout} aria-label={copy.logout}><LogOut size={18} /></button>
        </Fragment>
    </HeaderFrame>
    <main id="console-main" class="shell" tabindex="-1">
      <div id="page-alert" class="notice notice-error" role="alert" hidden></div>
      <div id="page-loading" class="page-loading" role="status">{copy.loading}</div>
      <section id="list-view" hidden>
        <div class="view-heading"><div><h1>{copy.permanent}</h1><p class="muted"><span id="route-count">-- / 5</span><span class="divider">·</span>{copy.safetyLimit}</p></div><div class="heading-actions"><button class="icon-button" data-refresh title={copy.refresh} aria-label={copy.refresh}><RefreshCw size={18} /></button><a id="new-route-link" class="button primary" href={consoleURL(locale, 'new')}><Plus size={17} />{copy.newRoute}</a></div></div>
        <nav class="console-tabs" aria-label={copy.permanent}><a id="active-tab" href={consoleURL(locale)}>{copy.permanent}</a><a id="deleted-tab" href={consoleURL(locale, '', true)}>{copy.deleted}</a></nav>
        <div id="account-stats" class="stats-band"><div><span>{copy.online}</span><strong id="online-count">--</strong></div><div><span>{copy.connections}</span><strong id="total-connections">--</strong></div><div><span>{copy.upload} <small>UTC</small></span><strong id="total-upload">--</strong></div><div><span>{copy.download} <small>UTC</small></span><strong id="total-download">--</strong></div></div>
        <p id="partial-stats" class="muted small" hidden>{copy.partial}</p>
        <div class="table-scroll"><table id="route-table"><thead><tr id="route-head"></tr></thead><tbody id="route-rows"></tbody></table></div>
        <div id="empty-list" class="empty-state" hidden><img src="/nodelane-mark-96.png" width="40" height="40" alt="" /><h2 id="empty-title">{copy.emptyActive}</h2><a id="empty-create" href={consoleURL(locale, 'new')} class="button primary"><Plus size={17} />{copy.newRoute}</a></div>
      </section>
      <section id="new-view" hidden>
        <a class="back-link" href={consoleURL(locale)}><ArrowLeft size={16} />{copy.back}</a>
        <div class="view-heading"><div><h1>{copy.newRoute}</h1><p class="muted">{copy.safetyLimit}</p></div></div>
        <form id="create-form" class="create-form">
          <div class="field"><label for="route-protocol">{copy.protocol}</label><input id="route-protocol" class="form-control" value="HTTP" readonly /></div>
          <div class="field"><label for="subdomain">{copy.domain}</label><div class="domain-input" dir="ltr"><input id="subdomain" class="form-control" name="subdomain" type="text" minlength="3" maxlength="32" autocapitalize="none" autocomplete="off" spellcheck="false" required aria-describedby="domain-validation" /><span id="domain-suffix"></span></div><p id="domain-validation" class="field-hint" aria-live="polite">{errors.subdomain_invalid}</p></div>
          <div class="form-actions"><button id="create-route" type="submit" class="button primary"><Plus size={17} />{copy.create}</button><a class="button" href={consoleURL(locale)}>{copy.cancel}</a></div>
        </form>
      </section>
      <section id="detail-view" hidden>
        <a id="detail-back" class="back-link" href={consoleURL(locale)}><ArrowLeft size={16} />{copy.back}</a>
        <div class="view-heading"><div class="domain-heading"><div class="heading-label">HTTP<span class="divider">·</span><span id="route-status"></span></div><h1 id="detail-domain" dir="ltr"></h1><a id="public-link" class="text-link" target="_blank" rel="noopener noreferrer" hidden><ExternalLink size={15} />{copy.open}</a></div><button class="icon-button" data-refresh title={copy.refresh} aria-label={copy.refresh}><RefreshCw size={18} /></button></div>
        <div class="run-line"><span>{copy.currentRun}</span><span id="detail-run-state" class="state"></span><code id="detail-run-id" dir="ltr"></code></div>
        <div id="deleted-notice" class="notice" hidden><span>{copy.until} </span><time id="recover-until"></time><button id="detail-restore" class="button compact"><RotateCcw size={16} />{copy.restore}</button></div>
        <section id="launch-section" class="detail-section" aria-labelledby="launch-title"><h2 id="launch-title">{copy.launch}</h2><p id="active-run-note" class="notice" hidden>{copy.runActive}</p>
          <form id="launch-form"><div class="target-fields"><div class="field"><label for="local-host">{copy.host}</label><input id="local-host" class="form-control" value="localhost" autocomplete="off" spellcheck="false" maxlength="253" dir="ltr" /></div><div class="field port-field"><label for="local-port">{copy.port}</label><input id="local-port" class="form-control" type="number" value="3000" min="1" max="65535" step="1" required dir="ltr" /></div></div>
            <div class="launch-toolbar"><div class="control-group" aria-label={copy.launch}>{(['linux','powershell','cmd'] as const).map(shell => <button type="button" data-command-shell={shell} aria-pressed={shell === 'linux'}>{shell === 'linux' ? 'Linux' : shell === 'powershell' ? 'PowerShell' : 'CMD'}</button>)}</div><button id="copy-launch" type="submit" class="button primary"><Copy size={17} /><span id="copy-launch-label">{copy.copy}</span></button></div>
          </form>
          <p id="launch-feedback" role="status" class="small muted"></p><pre id="command-display" class="command-display" dir="ltr" hidden><code id="launch-command"></code></pre><textarea id="manual-command" class="form-control manual-command" aria-label={copy.manual} readonly hidden dir="ltr"></textarea>
        </section>
        <section class="detail-section" aria-labelledby="stats-title"><div class="section-title"><h2 id="stats-title">{copy.currentRun}</h2><span id="stats-availability" class="small muted"></span></div><div class="stats-band"><div><span>{copy.connections}</span><strong id="detail-connections">--</strong></div><div><span>{copy.upload} <small>UTC</small></span><strong id="detail-upload">--</strong></div><div><span>{copy.download} <small>UTC</small></span><strong id="detail-download">--</strong></div></div><time id="observed-at" class="small muted"></time></section>
        <section class="detail-section"><button id="stop-run" class="button"><Square size={16} />{copy.stop}</button></section>
        <section class="detail-section danger-zone"><h2>{copy.deleteZone}</h2><button id="delete-route" class="button danger"><Trash size={17} />{copy.delete}</button></section>
      </section>
      <button id="page-retry" class="button" hidden><RefreshCw size={16} />{copy.retry}</button>
    </main>
    <dialog id="confirm-dialog" aria-labelledby="confirm-title" aria-describedby="confirm-description"><form method="dialog"><div class="dialog-heading"><h2 id="confirm-title">{copy.confirm}</h2><button class="icon-button" value="cancel" title={copy.cancel} aria-label={copy.cancel}><X size={18} /></button></div><p id="confirm-domain" class="confirm-domain" dir="ltr"></p><p id="confirm-description"></p><div class="form-actions"><button class="button" value="cancel" autofocus>{copy.cancel}</button><button id="confirm-action" class="button danger" value="confirm">{copy.confirm}</button></div></form></dialog>
    <template id="restore-icon"><RotateCcw size={16} aria-hidden="true" /></template>
    <script>import { mountConsole } from '../../console/app'; mountConsole();</script>
  </body>
</html>
