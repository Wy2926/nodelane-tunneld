---
import {
  getLocalePath,
  localeDefinitions,
  type Locale,
  type Translation,
} from "../i18n";

interface Props {
  locale: Locale;
  copy: Translation;
}

const { locale, copy } = Astro.props;
const home = getLocalePath(locale);
---

<header class="site-header">
  <div class="header-inner shell">
    <a class="brand-lockup" href={`${home}#start`} title={copy.brandHome} translate="no">
      <img class="brand-mark" src="/nodelane-mark-96.png" width="96" height="96" alt="" />
      <span class="brand-name">NodeLane</span>
      <span class="brand-product" aria-current="page">Tunnel</span>
    </a>

    <nav class="main-nav" aria-label={copy.navLabel}>
      <a class="active" href="#start" data-section-link="start">{copy.nav.start}</a>
      <a href="#protocols" data-section-link="protocols">{copy.nav.protocols}</a>
      <a href="#access" data-section-link="access">{copy.nav.access}</a>
    </nav>

    <div class="header-actions">
      <details class="feedback-menu" data-feedback-menu>
        <summary class="feedback-trigger">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5.5 17.5 3 21v-5.1A8.5 8.5 0 0 1 12 3a8.5 8.5 0 0 1 0 17 9.1 9.1 0 0 1-6.5-2.5Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M8 12h8M8 8.5h5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
          </svg>
          <span>{copy.feedback.label}</span>
        </summary>
        <nav class="feedback-popover" aria-label={copy.feedback.menuLabel}>
          <a href="https://github.com/Wy2926/nodelane-tunneld/discussions" target="_blank" rel="noreferrer">
            <span aria-hidden="true">↗</span>
            <strong>{copy.feedback.discussion}</strong>
          </a>
          <a href="https://github.com/Wy2926/nodelane-tunneld/issues/new?template=bug-report.yml" target="_blank" rel="noreferrer">
            <span aria-hidden="true">!</span>
            <strong>{copy.feedback.issue}</strong>
          </a>
          <a href="https://github.com/Wy2926/nodelane-tunneld/security/advisories/new" target="_blank" rel="noreferrer">
            <span aria-hidden="true">◇</span>
            <strong>{copy.feedback.security}</strong>
          </a>
        </nav>
      </details>
      <a
        class="site-link github-link"
        href="https://github.com/Wy2926/nodelane-tunneld"
        aria-label="GitHub"
      >
        <span>GitHub</span>
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.24c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.98 10.98 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.39-5.29 5.68.42.36.79 1.07.79 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"></path>
        </svg>
      </a>
      <label class="language-switch" data-language-switch>
        <span class="visually-hidden">{copy.languageLabel}</span>
        <svg class="language-icon" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.25"></circle>
          <path d="M2 8h12M8 1.75c1.7 1.7 2.55 3.78 2.55 6.25S9.7 12.55 8 14.25C6.3 12.55 5.45 10.47 5.45 8S6.3 3.45 8 1.75Z" fill="none" stroke="currentColor" stroke-width="1.1"></path>
        </svg>
        <select data-language-select aria-label={copy.languageLabel} lang={locale}>
          {localeDefinitions.map((definition) => (
            <option
              value={definition.code}
              data-path={getLocalePath(definition.code)}
              lang={definition.code}
              dir={definition.direction}
              selected={definition.code === locale}
            >
              {definition.nativeName}
            </option>
          ))}
        </select>
        <svg class="language-chevron" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
          <path d="m2 3.5 3 3 3-3" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </label>
      <a class="site-link main-site-link" href="https://www.nodelane.net/" aria-label={copy.mainSiteLabel}>
        <span>{copy.mainSite}</span>
        <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
          <path d="M3 9 9 3M4 3h5v5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLElement>("[data-language-switch]").forEach((root) => {
    const select = root.querySelector<HTMLSelectElement>("[data-language-select]");
    if (!select) return;

    select.addEventListener("change", () => {
      const option = select.selectedOptions[0];
      const path = option?.dataset.path;
      if (!path) return;

      const target = new URL(path, window.location.origin);
      target.search = window.location.search;
      target.hash = window.location.hash;
      window.location.assign(target);
    });
  });

  document.querySelectorAll<HTMLDetailsElement>("[data-feedback-menu]").forEach((menu) => {
    const trigger = menu.querySelector<HTMLElement>("summary");

    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) {
        menu.removeAttribute("open");
      }
    });

    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        menu.removeAttribute("open");
        trigger?.focus();
      }
    });
  });
</script>
