---
import type { Translation } from "../i18n";

interface Props {
  copy: Translation["quickstart"];
}

const { copy } = Astro.props;
---

<section
  class="quickstart"
  aria-label={copy.ariaLabel}
  data-command-builder
  data-copy-label={copy.copy}
  data-copied-label={copy.copied}
  data-selected-label={copy.selected}
>
  <div class="quickstart-head">
    <div class="quickstart-title">
      <strong>{copy.title}</strong>
      <span>{copy.subtitle}</span>
    </div>
    <div class="control-groups">
      <div class="control-group" data-shell-group aria-label={copy.shellLabel} hidden>
        <button class="active" type="button" data-shell="powershell" aria-pressed="true">PowerShell</button>
        <button type="button" data-shell="cmd" aria-pressed="false">CMD</button>
      </div>
      <div class="control-group" aria-label={copy.osLabel}>
        <button class="active" type="button" data-os="linux" aria-pressed="true">Linux</button>
        <button type="button" data-os="windows" aria-pressed="false">Windows</button>
      </div>
    </div>
  </div>
  <div class="command-wrap">
    <div class="command">
      <span class="prompt" data-prompt aria-hidden="true">$</span>
      <pre><code data-command>curl -fsSL https://tunnel.nodelane.net/run.sh | sh</code></pre>
      <button class="copy" data-copy type="button" aria-live="polite">{copy.copy}</button>
    </div>
    <div class="quickstart-note">
      <code>{copy.afterRun}</code>
      <span>{copy.anonymous}</span>
    </div>
  </div>
</section>

<script>
  type OperatingSystem = "linux" | "windows";
  type WindowsShell = "powershell" | "cmd";

  const commands = {
    linux: "curl -fsSL https://tunnel.nodelane.net/run.sh | sh",
    powershell: "irm https://tunnel.nodelane.net/run.ps1 | iex",
    cmd: "curl -fsSL https://tunnel.nodelane.net/run.cmd | cmd",
  } as const;

  function commandFor(os: OperatingSystem, shell: WindowsShell): string {
    return os === "linux" ? commands.linux : commands[shell];
  }

  function selectPlainText(text: string): { copied: boolean; cleanup: () => void } {
    const activeElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    const textarea = document.createElement("textarea");
    textarea.value = text;
    textarea.readOnly = true;
    textarea.tabIndex = -1;
    textarea.setAttribute("aria-hidden", "true");
    textarea.style.cssText = "position:fixed;inset-block-start:0;inset-inline-start:-10000px;width:1px;height:1px;opacity:0;pointer-events:none";
    document.body.append(textarea);
    textarea.select();
    textarea.setSelectionRange(0, text.length);

    let copied = false;
    try {
      copied = document.execCommand("copy");
    } catch {
      // Keep the plain-text textarea selected so a manual copy cannot include rich HTML.
    }

    return {
      copied,
      cleanup: () => {
        textarea.remove();
        activeElement?.focus();
      },
    };
  }

  async function copyPlainText(text: string): Promise<{ copied: boolean; cleanup?: () => void }> {
    if (navigator.clipboard?.writeText && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(text);
        return { copied: true };
      } catch {
        // Clipboard permission can be denied; use a text-only legacy fallback.
      }
    }

    return selectPlainText(text);
  }

  function initializeCommandBuilder(root: HTMLElement): void {
    const command = root.querySelector<HTMLElement>("[data-command]");
    const prompt = root.querySelector<HTMLElement>("[data-prompt]");
    const copyButton = root.querySelector<HTMLButtonElement>("[data-copy]");
    const shellGroup = root.querySelector<HTMLElement>("[data-shell-group]");
    if (!command || !prompt || !copyButton || !shellGroup) return;

    const state: { os: OperatingSystem; shell: WindowsShell } = {
      os: /Windows/i.test(navigator.userAgent) ? "windows" : "linux",
      shell: "powershell",
    };

    const setPressed = (selector: string, value: string): void => {
      root.querySelectorAll<HTMLButtonElement>(selector).forEach((button) => {
        const active = button.dataset.os === value || button.dataset.shell === value;
        button.classList.toggle("active", active);
        button.setAttribute("aria-pressed", String(active));
      });
    };

    const render = (): void => {
      command.textContent = commandFor(state.os, state.shell);
      prompt.textContent = state.os === "linux" ? "$" : state.shell === "powershell" ? "PS>" : ">";
      shellGroup.hidden = state.os !== "windows";
      setPressed("[data-os]", state.os);
      setPressed("[data-shell]", state.shell);
    };

    root.querySelectorAll<HTMLButtonElement>("[data-os]").forEach((button) => {
      button.addEventListener("click", () => {
        state.os = button.dataset.os as OperatingSystem;
        render();
      });
    });

    root.querySelectorAll<HTMLButtonElement>("[data-shell]").forEach((button) => {
      button.addEventListener("click", () => {
        state.shell = button.dataset.shell as WindowsShell;
        render();
      });
    });

    copyButton.addEventListener("click", async () => {
      const text = commandFor(state.os, state.shell);
      const result = await copyPlainText(text);
      const status = result.copied
        ? root.dataset.copiedLabel ?? "Copied"
        : root.dataset.selectedLabel ?? "Selected";
      if (result.copied) result.cleanup?.();
      copyButton.textContent = status;
      window.setTimeout(() => {
        if (!result.copied) result.cleanup?.();
        copyButton.textContent = root.dataset.copyLabel ?? "Copy";
      }, 1400);
    });

    render();
  }

  document.querySelectorAll<HTMLElement>("[data-command-builder]").forEach(initializeCommandBuilder);
</script>
