---
import { Copy } from '@lucide/astro';
import { getTranslation, type Locale, type Translation } from '../i18n/index.ts';
interface Props { copy: Translation['quickstart']; locale: Locale }
const { copy, locale } = Astro.props;
const labels = getTranslation(locale).console;
---
<section class="quickstart" aria-label={copy.ariaLabel} data-command-builder data-locale={locale}>
  <div class="quickstart-head">
    <div class="quickstart-title"><strong>{copy.title}</strong><span>{copy.anonymous}</span></div>
    <div class="control-groups">
      <div class="control-group" data-shell-group aria-label={copy.shellLabel} hidden><button class="active" type="button" data-shell="powershell" aria-pressed="true">PowerShell</button><button type="button" data-shell="cmd" aria-pressed="false">CMD</button></div>
      <div class="control-group" aria-label={copy.osLabel}><button class="active" type="button" data-os="linux" aria-pressed="true">Linux</button><button type="button" data-os="windows" aria-pressed="false">Windows</button></div>
    </div>
  </div>
  <div class="command-wrap">
    <div class="quickstart-fields"><label>{labels.protocol}<select class="form-control" data-protocol aria-label={labels.protocol}><option value="http">HTTP</option><option value="tcp">TCP</option><option value="udp">UDP</option></select></label><label>{labels.host}<input class="form-control" data-host value="localhost" maxlength="253" autocomplete="off" spellcheck="false" dir="ltr" /></label><label>{labels.port}<input class="form-control" data-port type="number" min="1" max="65535" step="1" value="3000" dir="ltr" /></label></div>
    <div class="command"><span class="prompt" aria-hidden="true">$</span><pre dir="ltr"><code data-command></code></pre><button class="copy button primary" data-copy type="button" title={copy.copy}><Copy size={18} /><span>{copy.copy}</span></button></div>
    <p class="quickstart-result" data-command-status role="status"></p><textarea class="quickstart-manual form-control" data-manual aria-label={labels.manual} readonly hidden dir="ltr"></textarea>
  </div>
</section>
<script>
  import { initializeQuickStart } from '../lib/quickstart';
  document.querySelectorAll<HTMLElement>('[data-command-builder]').forEach(root => initializeQuickStart(root, navigator.clipboard, navigator.userAgent));
</script>
