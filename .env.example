# Fresh deployment only. PostgreSQL and Redis must already be reachable from
# the Linux host. Pass the private copy of this file explicitly with --env-file.
TZ=UTC
LISTEN_ADDR=127.0.0.1:9000
FRP_PLUGIN_LISTEN_ADDR=127.0.0.1:9001
RELEASE_DIR=/releases
LOG_LEVEL=info

# Image selection does not change the independently versioned nt client.
TUNNELD_VERSION=dev
NT_VERSION=
TUNNELD_IMAGE=

PUBLIC_ORIGIN=https://tunnel.nodelane.net
PUBLIC_DOMAIN=tunnel.nodelane.net
FRP_SERVER_ADDR=tunnel.nodelane.net
# Public port advertised to clients.
FRP_SERVER_PORT=7000
# Optional frps internal listener (1-65535); blank uses FRP_SERVER_PORT.
# Example: public 7001 -> raw TCP forwarding -> internal 7000.
FRPS_BIND_PORT=
FRP_TLS_SERVER_NAME=tunnel.nodelane.net
FRP_BANDWIDTH_LIMIT=5MB

# Absolute host paths are mounted read-only at exactly the same container paths.
# CA and server certificate files contain only public PEM certificates.
# Only frps receives the private-key mount. Never set FRP_AUTH_TOKEN.
FRPS_CONFIG_FILE=/etc/nodelane/frps.toml
FRP_TRUSTED_CA_FILE=/etc/nodelane/certs/frps-ca.crt
FRPS_CERT_FILE=/etc/nodelane/certs/frps.crt
FRPS_KEY_FILE=/etc/nodelane/certs/frps.key
FRPS_ADMIN_URL=http://127.0.0.1:7500
FRPS_ADMIN_USERNAME=
FRPS_ADMIN_PASSWORD=

DATABASE_URL=
# Redis must be a standalone primary with no replicas and maxmemory-policy
# noeviction. The service account needs INFO and CONFIG GET for startup checks.
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=nodelane:tunnel:control

# Seven distinct values, each exactly 32 cryptographically random bytes encoded
# as base64 or unpadded base64url. Required placeholders intentionally stay empty.
CONTROL_LAUNCH_PEPPER=
CONTROL_RUN_PEPPER=
CONTROL_REPLAY_KEY=
SESSION_ENCRYPTION_KEY=
ANONYMOUS_CREDENTIAL_PEPPER=
ANONYMOUS_REPLAY_KEY=
ANONYMOUS_FENCE_OWNER_TOKEN=

# Separate confidential Web and public native OIDC applications are required.
OIDC_ISSUER=https://auth.nodelane.net/oidc
OIDC_WEB_CLIENT_ID=
OIDC_WEB_CLIENT_SECRET=
OIDC_NATIVE_CLIENT_ID=

TCP_PORT_START=20000
TCP_PORT_END=29999
UDP_PORT_START=30000
UDP_PORT_END=39999
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
