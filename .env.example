DEV_MODE=false
LISTEN_ADDR=127.0.0.1:9000
RELEASE_DIR=/releases
LOG_LEVEL=info

# Deployment helper values; tunneld itself ignores them.
TUNNELD_VERSION=dev
# Optional override; image builds use client-version.txt when this is empty.
NT_VERSION=
TUNNELD_IMAGE=registry.example.com/example/nodelane-tunneld:0.4.2

# Scheme advertised for HTTP tunnel URLs. Use https only after wildcard TLS
# termination is configured for *.tunnel.nodelane.net.
PUBLIC_SCHEME=http
PUBLIC_DOMAIN=tunnel.nodelane.net
NODE_ID=primary

# Must match the already deployed frps instance.
FRP_SERVER_ADDR=tunnel.nodelane.net
FRP_SERVER_PORT=7000
FRP_AUTH_TOKEN=replace-with-current-frps-token
FRP_TLS_SERVER_NAME=tunnel.nodelane.net
FRP_BANDWIDTH_LIMIT=5MB

# tunneld uses host networking and reaches existing services only through
# their stable loopback ports. It does not depend on container names/networks.
DATABASE_URL=postgres://nodelane_tunnel:replace-db-password@127.0.0.1:5432/nodelane_tunnel?sslmode=disable
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=replace-with-existing-redis-password
REDIS_PREFIX=nodelane:tunnel

# Generate independent random secrets. TUNNEL_JWT_SECRET may be base64url.
TOKEN_PEPPER=replace-with-at-least-32-random-bytes
TUNNEL_JWT_SECRET=replace-with-at-least-32-random-bytes
ADMIN_TOKEN=replace-with-at-least-32-random-bytes

TUNNEL_TTL=1h
MAX_TUNNELS_PER_CLIENT=1
MAX_TUNNELS_PER_IP=2
TCP_PORT_START=20000
TCP_PORT_END=29999
UDP_PORT_START=30000
UDP_PORT_END=39999

# Only same-host reverse proxies may supply forwarding headers.
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
